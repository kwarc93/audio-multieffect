{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 23, "patch": 0 },

  "configurePresets": [
    {
      "name": "common",
      "description": "Shared settings for all 4 board configurations. Not selectable directly (hidden).",
      "hidden": true,
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "${sourceDir}/cmake/arm-none-eabi-gcc.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "STM32F746G-DISCO",
      "displayName": "STM32F746G-DISCO",
      "description": "F746G board, single CM7 core.",
      "inherits": "common",
      "cacheVariables": { "BOARD": "STM32F746G-DISCO" }
    },
    {
      "name": "STM32H745I-DISCO",
      "displayName": "STM32H745I-DISCO (single-core)",
      "description": "H745 board, single CM7 core.",
      "inherits": "common",
      "cacheVariables": { "BOARD": "STM32H745I-DISCO" }
    },
    {
      "name": "STM32H745I-DISCO-CM7",
      "displayName": "STM32H745I-DISCO-CM7 (dual-core)",
      "description": "H745 board, dual-core build: CM7 core (DSP).",
      "inherits": "common",
      "cacheVariables": { "BOARD": "STM32H745I-DISCO-CM7" }
    },
    {
      "name": "STM32H745I-DISCO-CM4",
      "displayName": "STM32H745I-DISCO-CM4 (dual-core)",
      "description": "H745 board, dual-core build: CM4 core (GUI).",
      "inherits": "common",
      "cacheVariables": { "BOARD": "STM32H745I-DISCO-CM4" }
    }
  ],

  "buildPresets": [
    { "name": "STM32F746G-DISCO",     "configurePreset": "STM32F746G-DISCO" },
    { "name": "STM32H745I-DISCO",     "configurePreset": "STM32H745I-DISCO" },
    { "name": "STM32H745I-DISCO-CM7", "configurePreset": "STM32H745I-DISCO-CM7" },
    { "name": "STM32H745I-DISCO-CM4", "configurePreset": "STM32H745I-DISCO-CM4" }
  ]
}
